{
  "name": "@getui/ido-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Getui IDO statistics APIs",
  "type": "module",
  "bin": {
    "getui-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:e2e": "vitest run tests/cli.e2e.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "13.1.0",
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "5.0.1",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
